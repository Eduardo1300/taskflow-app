# ============================================
# TaskFlow - Variables de Entorno
# ============================================
# Copiar este archivo a .env.local para desarrollo local
# NO commitear .env.local (está en .gitignore)

# ============================================
# Backend (NestJS)
# ============================================
# Base de datos PostgreSQL (Neon, Render, Supabase, local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taskflow

# JWT Secret para autenticación (CAMBIAR EN PRODUCCIÓN)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Puerto del backend
PORT=3000

# ============================================
# Frontend (Vue 3 + Vite)
# ============================================
# URL de la API del backend (incluye /api al final)
VITE_API_URL=http://localhost:3000/api